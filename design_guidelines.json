  "instructions_to_main_agent": [
    "Build a robust Virtual Indian Kitchen & Nutrition Simulator app with a rich catalog of 40+ authentic Indian ingredients (Lentils/Pulses, Spices, Vegetables, Oils/Dairy, Grains).",
    "Allow user to search, filter by category, and add ingredients into the active Virtual Cooking Pot/Kadai.",
    "Implement unit selector for every ingredient: Grams (g), Milliliters (ml), Pieces/Count (e.g. 2 Tomatoes, 4 Garlic cloves), or Tablespoons (tbsp e.g. 1 tbsp Ghee, 0.5 tbsp Turmeric).",
    "Provide interactive selector for all 8 requested cooking methods: Boiling, Frying, Deep Frying, Sautéing, Roasting, Pressure Cooking, Steaming, and Baking.",
    "Compute real-time weight changes (evaporation vs water absorption vs oil uptake) and nutrient retention factors (Calories, Protein, Carbs, Fat, Fiber, Sodium, Iron, Calcium).",
    "Include preloaded recipe cards (Andhra Tomato Pappu, Dhaba Paneer Butter Masala, Amritsari Chana Masala, Hyderabadi Dum Biryani) with one-click load into pot.",
    "Display real-time nutritional summary dashboard with macro donut charts, micro nutrient progress bars vs RDA %, per-serving scaler, and cooking method impact comparison modal.",
    "Ensure all interactive buttons, inputs, tabs, and nutrient metrics include explicit data-testid attributes for automated test validation.",
    "Adhere strictly to the warm spice palette (#120E0C background, #D95D39 terracotta accents, #E5A93C turmeric gold highlights) with glowing semi-transparent glass cards."
  ],
  "UNIVERSAL GUIDELINES FOR MAIN AGENT": {
    "do_not_center_app": "Avoid text-align: center on root container. Use left-aligned readable grid flows with asymmetric visual highlights.",
    "transitions": "Use explicit CSS property transitions (e.g., transition: background-color 0.2s, transform 0.2s). DO NOT use transition: all.",
    "data_testid": "Add data-testid to every interactive input, button, select, recipe card, and nutrient output cell.",
    "no_emoji_icons": "Use Lucide or Phosphor React icons instead of raw AI assistant emojis for UI controls."
  }
}