{
  "project_title": "Virtual Rasoi - Interactive Indian Culinary & Nutrient Simulator",
  "archetype": "ORGANIC & EARTHY / TACTICAL SPICE LAB",
  "theme": {
    "mode": "dark",
    "background_primary": "#120E0C",
    "background_secondary": "#1E1713",
    "card_background": "#261E19",
    "card_border": "#3D3028",
    "primary_accent": "#D95D39",
    "secondary_accent": "#E5A93C",
    "tertiary_accent": "#5B8A62",
    "highlight_glow": "#F28A2E",
    "text_primary": "#F7EFE9",
    "text_secondary": "#C4B2A5",
    "text_muted": "#8C7A6D"
  },
  "typography": {
    "display_font": "Bricolage Grotesque, Outfit, sans-serif",
    "heading_font": "Outfit, sans-serif",
    "body_font": "Plus Jakarta Sans, sans-serif",
    "mono_font": "JetBrains Mono, monospace",
    "scale": {
      "h1": "text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-none",
      "h2": "text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight",
      "h3": "text-xl sm:text-2xl font-semibold",
      "h4": "text-lg font-medium",
      "body": "text-base leading-relaxed",
      "small": "text-xs uppercase tracking-widest font-semibold"
    }
  },
  "color_palette": {
    "terracotta": "#D95D39",
    "turmeric_gold": "#E5A93C",
    "saffron_orange": "#F28A2E",
    "cardamom_green": "#5B8A62",
    "chili_red": "#C83E2B",
    "masala_charcoal": "#120E0C",
    "spice_bark": "#1E1713",
    "clay_surface": "#261E19",
    "brass_accent": "#B8860B",
    "cream_text": "#F7EFE9",
    "warm_gray": "#C4B2A5",
    "deep_border": "rgba(229, 169, 60, 0.15)"
  },
  "layout_and_grids": {
    "container": "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8",
    "bento_hero": "grid grid-cols-1 lg:grid-cols-12 gap-6 items-start",
    "pan_builder_span": "lg:col-span-7 space-y-6",
    "nutrition_dashboard_span": "lg:col-span-5 space-y-6 lg:sticky lg:top-24",
    "ingredient_drawer_grid": "grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3",
    "nutrient_grid": "grid grid-cols-2 sm:grid-cols-4 gap-4"
  },
  "key_features_and_simulation_logic": {
    "unit_conversions": {
      "grams": "1g = 1g baseline",
      "milliliters": "1ml = 1g for liquids like water/milk, 0.92g for oil/ghee",
      "pieces_count": "Pre-configured piece weights (e.g. 1 Tomato = 90g, 1 Onion = 110g, 1 Green Chili = 5g, 1 Potato = 150g, 1 Garlic Clove = 3g)",
      "tablespoons": "1 tbsp spices = 6g, 1 tbsp oil/ghee = 14g, 1 tbsp dal = 12g, 1 tbsp ginger-garlic paste = 15g"
    },
    "cooking_method_adjustments": {
      "boiling": {
        "weight_yield_factor": 1.45,
        "water_retention": "+40-60% weight from absorbed water in lentils/grains",
        "oil_uptake_g": 0,
        "vitamin_c_retention": 0.55,
        "calcium_iron_retention": 0.95,
        "calories_multiplier": 1.0
      },
      "frying": {
        "weight_yield_factor": 0.82,
        "water_loss": "-18% moisture loss",
        "oil_uptake_g": 12.0,
        "vitamin_c_retention": 0.70,
        "calcium_iron_retention": 0.98,
        "calories_multiplier": 1.0
      },
      "deep_frying": {
        "weight_yield_factor": 0.75,
        "water_loss": "-25% moisture evaporation",
        "oil_uptake_g": 25.0,
        "vitamin_c_retention": 0.45,
        "calcium_iron_retention": 0.90,
        "calories_multiplier": 1.0
      },
      "sauteing": {
        "weight_yield_factor": 0.88,
        "water_loss": "-12% moisture loss",
        "oil_uptake_g": 7.0,
        "vitamin_c_retention": 0.80,
        "calcium_iron_retention": 0.98,
        "calories_multiplier": 1.0
      },
      "roasting": {
        "weight_yield_factor": 0.78,
        "water_loss": "-22% dry heat moisture loss",
        "oil_uptake_g": 3.0,
        "vitamin_c_retention": 0.65,
        "calcium_iron_retention": 0.99,
        "calories_multiplier": 1.0
      },
      "pressure_cooking": {
        "weight_yield_factor": 1.55,
        "water_retention": "+55% moisture retention & tenderizing",
        "oil_uptake_g": 0,
        "vitamin_c_retention": 0.75,
        "calcium_iron_retention": 0.97,
        "calories_multiplier": 1.0
      },
      "steaming": {
        "weight_yield_factor": 1.05,
        "water_retention": "+5% moisture condensed",
        "oil_uptake_g": 0,
        "vitamin_c_retention": 0.88,
        "calcium_iron_retention": 0.99,
        "calories_multiplier": 1.0
      },
      "baking": {
        "weight_yield_factor": 0.80,
        "water_loss": "-20% moisture loss",
        "oil_uptake_g": 4.0,
        "vitamin_c_retention": 0.60,
        "calcium_iron_retention": 0.98,
        "calories_multiplier": 1.0
      }
    },
